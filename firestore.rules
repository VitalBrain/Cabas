rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Matrice d'Eisenhower : chaque compte lit et écrit uniquement ses propres tâches
    match /users/{userId}/tasks/{taskId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    // Carnet muscu : chaque compte lit et écrit uniquement ses propres séances
    match /muscu/{uid}/{document=**} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }

    // 3615 JEUX : chaque compte lit et écrit uniquement ses propres scores
    match /jeux3615_users/{uid} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }
    // INFLUENCEURS: Base de donnée sans numéros
    match /users/{uid}/influenceurs/{docId} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }

    // Forma : réglages, liaison Strava, activités et séances planifiées de chaque compte
    match /users/{uid}/forme/{docId} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }
    match /users/{uid}/formeActivities/{actId} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }
    match /users/{uid}/formePlans/{planId} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }

    // Cabas : listes de courses partagées entre plusieurs comptes Google
    function signedIn() {
      return request.auth != null && request.auth.token.email != null;
    }
    function myEmail() {
      return request.auth.token.email.lower();
    }
    function isListMember(listId) {
      return signedIn()
        && myEmail() in get(/databases/$(database)/documents/cabas_lists/$(listId)).data.memberEmails;
    }

    match /cabas_lists/{listId} {
      allow read: if signedIn() && myEmail() in resource.data.memberEmails;

      allow create: if signedIn()
        && request.resource.data.ownerUid == request.auth.uid
        && myEmail() in request.resource.data.memberEmails;

      allow update: if signedIn() && (
        (myEmail() in resource.data.memberEmails
          && request.resource.data.ownerUid == resource.data.ownerUid)
        ||
        (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['memberEmails', 'joinCode', 'members'])
          && request.resource.data.joinCode is string
          && get(/databases/$(database)/documents/cabas_invites/$(request.resource.data.joinCode)).data.listId == listId
          && request.resource.data.memberEmails.hasAll(resource.data.memberEmails)
          && request.resource.data.memberEmails.size() == resource.data.memberEmails.size() + 1
          && myEmail() in request.resource.data.memberEmails
          && request.resource.data.members.diff(resource.data.members).affectedKeys().hasOnly([request.auth.uid]))
      );

      allow delete: if signedIn() && resource.data.ownerUid == request.auth.uid;

      match /items/{itemId} {
        allow read, write: if isListMember(listId);
      }
    }

    match /cabas_invites/{code} {
      allow get: if signedIn();
      allow create: if isListMember(request.resource.data.listId);
      allow delete: if isListMember(resource.data.listId);
    }

    match /cabas_users/{uid}/{document=**} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }
  }
}
